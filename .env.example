# AI Provider OS - Environment Variables
# Copiar para .env e preencher - NUNCA commitar .env com keys reais

# Backend
SECRET_KEY=change-me-32chars-minimum-secret-key-prod
ENCRYPTION_KEY=  # Gerado automaticamente em .fernet_key - deixar vazio usa .fernet_key
DATABASE_URL=sqlite:///./ai_provider_os.db
# Para Postgres prod: DATABASE_URL=postgresql://user:pass@host:5432/ai_provider_os

# CORS - Prod deve listar domínios específicos, não *
CORS_ORIGINS=*
# Ex prod: CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# API Keys - Provider OS (você no centro, você fornece suas keys)
# Groq - https://console.groq.com
GROQ_API_KEY=
# Cerebras - https://inference.cerebras.ai
CEREBRAS_API_KEY=
# Mistral - https://console.mistral.ai
MISTRAL_API_KEY=
# OpenRouter - https://openrouter.ai/keys
OPENROUTER_API_KEY=
# HuggingFace - https://huggingface.co/settings/tokens
HF_TOKEN=
HUGGINGFACE_API_KEY=
# Cohere - https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
# Nvidia - https://build.nvidia.com
NVIDIA_API_KEY=
# DeepSeek - https://platform.deepseek.com
DEEPSEEK_API_KEY=
# Gemini - https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Chutes - https://chutes.ai
CHUTES_API_KEY=
# Sambanova - https://cloud.sambanova.ai
SAMBANOVA_API_KEY=
# Cloudflare - https://dash.cloudflare.com
CLOUDFLARE_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
# Prod: NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# Docker / Compose
# REDIS_URL=redis://redis:6379/0
# Para ativar Redis cache: descomentar e configurar redis service

# Observability
# GRAFANA - dashboard em grafana-dashboard.json
# Prometheus metrics endpoint: /metrics (quando habilitado)

# Security - P5
# ENABLE_AUDIT_LOG=true
# ENABLE_KEY_ROTATION=true
# LOG_SENSITIVE=false - nunca true em prod

# Rigor - P7 target 60%
# RIGOR_TARGET=60
